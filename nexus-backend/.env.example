# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SERVICE_NAME=nexus-backend

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# ── Keycloak (Auth) ───────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nexus
KEYCLOAK_CLIENT_ID=nexus-backend

# Set to true to bypass JWT validation in local development
AUTH_DISABLED=true

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Python AI Service (nexus-api) ─────────────────────────────────────────────
# The Python service owns AI, OCR, and ML analysis
AI_SERVICE_URL=http://localhost:8000

# ── NATS (Phase 4) ────────────────────────────────────────────────────────────
# NATS_URL=nats://localhost:4222

# ── Temporal (Phase 3) ────────────────────────────────────────────────────────
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=nexus
