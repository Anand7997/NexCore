# Server Environment Configuration
# Use this for server deployment at 15.134.56.119
# Frontend: http://15.134.56.119:8081/
# Backend: http://15.134.56.119:3001/

# Backend API URL for server deployment
VITE_API_BASE_URL=http://15.134.56.119:3001

# Environment identifier
# Note: NODE_ENV=production is handled by Vite config, not in .env files
VITE_ENV=server

# Server deployment settings
VITE_DEV_MODE=false
VITE_DEBUG=false
