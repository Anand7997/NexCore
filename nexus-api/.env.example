# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=NEXUS QA Orchestration API
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/NexCore
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/NexCore

# ── Phase 6: AI Intelligence ──────────────────────────────────────────────────

# NATS — Python worker subscribes to ai.jobs, publishes to ai.results
NATS_URL=nats://localhost:4222
CONTROL_PLANE_URL=http://localhost:3001

# Qdrant vector store — failure memory and locator collections
# AI workflow LLM keys. Add only the key for the provider you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-5.5
AI_WORKFLOW_TESTCASE_CONCURRENCY=2
MCP_PLAYWRIGHT_URL=
PLAYWRIGHT_FALLBACK=true

# Local Qdrant does not need an API key. Use QDRANT_API_KEY only for hosted/cloud Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embedding model (local sentence-transformers, no API key required)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
WARMUP_EMBEDDINGS_ON_STARTUP=false

# Set to true and provide OPENAI_API_KEY to use text-embedding-3-small instead
USE_OPENAI_EMBEDDINGS=false
